generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String    @id @default("default")
  name      String
  budget    Float?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id            String   @id
  projectId     String   @default("default")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  category      String
  kind          String
  quantity      Float?
  unit          String
  amount        Float
  paymentMethod String
  paymentOwner  String?
  status        String
  date          String
  note          String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([projectId])
}
